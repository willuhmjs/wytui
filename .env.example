# Database connection (REQUIRED)
# Replace [CHANGE_ME] with a strong password
DATABASE_URL=postgresql://postgres:[CHANGE_ME]@localhost:5432/wytui?schema=public

# Authentication secret (REQUIRED)
# Generate with: openssl rand -hex 32
AUTH_SECRET=[CHANGE_ME]

# Application settings
AUTH_TRUST_HOST=true
ORIGIN=http://localhost:3000
NODE_ENV=development

# Auto-create admin user, skipping the setup wizard (optional)
# ADMIN_USERNAME=admin@example.com
# ADMIN_PASSWORD=[CHANGE_ME]

# Background queue concurrency limits (optional, clamped to 1-20)
# QUEUE_MAX_DOWNLOADS overrides the app setting at startup; the others have no UI equivalent
# QUEUE_MAX_DOWNLOADS=2      # concurrent yt-dlp download jobs
# QUEUE_MAX_METADATA=1       # concurrent metadata fetches (keep low to not overwhelm YouTube)
# QUEUE_MAX_SUBSCRIPTIONS=3  # concurrent subscription checks
# QUEUE_MAX_SYSTEM=2         # concurrent system jobs (cache-cleanup, syncs, backups)
# QUEUE_MAX_UNLISTED=5       # fallback cap for any other job type

# OIDC (optional)
# OIDC_ISSUER_URL=https://your-provider.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_DISPLAY_NAME=SSO
