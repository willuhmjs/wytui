generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Auth.js models
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String?   @unique // optional login handle; login accepts email OR username
  password          String?
  name              String?
  emailVerified     DateTime?
  image             String?
  isAdmin           Boolean   @default(false)
  passwordChangedAt DateTime? // For session revocation on password change
  // Per-user overrides (null = inherit the global default from Settings)
  libraryAccess     Boolean?  // whether this user may save to the library
  cacheQuotaBytes   BigInt?   // override for this user's cache limit
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  downloads     Download[]
  profiles      DownloadProfile[]
  subscriptions Subscription[]
  apiKeys       ApiKey[]
  preferences   UserPreference[]
  watchProgress WatchProgress[]
  playlists     Playlist[]
  libraryRequests LibraryRequest[]
  youtubeLink   YouTubeLink?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ApiKey {
  id        String    @id @default(cuid())
  keyHash   String    @unique
  keyPrefix String
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("api_keys")
}

// Download profiles (quality presets + custom)
model DownloadProfile {
  id          String    @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean   @default(false)
  isSystem    Boolean   @default(false) // System presets cannot be deleted

  // Video settings
  format      String?   // mp4, webm, mkv
  quality     String?   // best, 2160p, 1080p, 720p, 480p, worst
  codec       String?   // h264, vp9, av1

  // Audio settings
  audioOnly   Boolean   @default(false)
  audioFormat String?   // mp3, aac, flac, opus, m4a
  audioBitrate String?  // 320k, 256k, 128k

  // Advanced options
  customFlags String[]  // Additional yt-dlp flags

  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  downloads        Download[]
  subscriptions    Subscription[]
  monitors         Monitor[]
  channelOverrides ChannelOverride[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, name])
  @@map("download_profiles")
}

// Individual download jobs
model Download {
  id          String         @id @default(cuid())
  url         String
  status      DownloadStatus @default(PENDING)

  // Metadata (fetched in phase 1)
  title       String?
  thumbnail   String?
  duration    Int?      // seconds
  uploader    String?
  channelUrl  String?
  uploadDate  DateTime?
  format      String?   // resolved format string
  filesize    BigInt?   // bytes (estimated)
  height      Int?      // video height in pixels (e.g. 1080, 2160)

  // Video classification & metadata
  videoType     String?   // "regular", "short", "stream"
  description   String?   @db.Text
  category      String?
  tags          String[]
  dislikeCount  Int?
  videoId       String?   // YouTube video ID for dedup/search

  // Music metadata (resolved via yt-dlp or MusicBrainz)
  artist        String?
  album         String?
  trackNumber   Int?
  releaseYear   Int?
  musicBrainzId String?

  // Progress tracking
  progress    Float     @default(0) // 0-100
  speed       String?   // e.g., "1.2MiB/s"
  eta         String?   // e.g., "00:15"
  downloadedBytes BigInt? @default(0)
  totalBytes  BigInt?

  // Output
  filename    String?
  filepath    String?   // Absolute path on server

  // Per-download flag overrides (from advanced mode)
  customFlags String[]

  // Error handling
  error       String?
  retryCount  Int       @default(0)

  // Relations
  profileId   String
  profile     DownloadProfile @relation(fields: [profileId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Storage pool
  storagePool String    @default("cache") // "cache" | "library"

  // Relations
  downloadTasks  DownloadTask[]
  watchProgress  WatchProgress[]
  playlistItems  PlaylistItem[]
  subtitleLines  SubtitleLine[]
  libraryRequest LibraryRequest?

  // From subscription (optional)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?
  allWatchedAt DateTime?

  @@index([status])
  @@index([userId])
  @@index([subscriptionId])
  @@index([createdAt])
  @@index([storagePool])
  @@index([videoId])
  // Note: PostgreSQL full-text search vector (search_vector tsvector) is managed
  // as a GENERATED column via migration. It combines title, description, and uploader.
  @@map("downloads")
}

model SubtitleLine {
  id         String   @id @default(cuid())
  downloadId String
  download   Download @relation(fields: [downloadId], references: [id], onDelete: Cascade)
  startTime  Float    // seconds
  endTime    Float    // seconds
  text       String
  lang       String   @default("en")

  @@index([downloadId])
  // Note: PostgreSQL full-text search vector (search_vector tsvector) is managed
  // as a GENERATED column via migration for subtitle text search.
  @@map("subtitle_lines")
}

model DownloadTask {
  id          String    @id @default(cuid())
  downloadId  String
  download    Download  @relation(fields: [downloadId], references: [id], onDelete: Cascade)
  type        String
  status      String    @default("pending")
  progress    Float?
  message     String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([downloadId])
  @@map("download_tasks")
}

enum DownloadStatus {
  PENDING       // Queued, waiting for slot
  FETCHING_INFO // Phase 1: Getting metadata
  DOWNLOADING   // Phase 2: Active download
  PROCESSING    // Post-processing (audio extraction, etc.)
  COMPLETED
  FAILED
  CANCELLED
  DELETED       // File deleted, record retained for redownload
}

// Channel/playlist subscriptions
model Subscription {
  id          String    @id @default(cuid())
  url         String    // Channel or playlist URL
  name        String
  type        SubscriptionType @default(CHANNEL)

  // Monitoring settings
  enabled     Boolean   @default(true)
  checkInterval Int     @default(1800) // seconds (default: 30 min)
  lastChecked DateTime?
  lastVideoDate DateTime?

  // Download settings
  profileId   String
  profile     DownloadProfile @relation(fields: [profileId], references: [id])
  autoDownload Boolean  @default(true)
  saveToLibrary Boolean @default(false)
  customFlags String[]  // Per-subscription yt-dlp flags (SponsorBlock, subtitles, etc.)

  // Metadata
  thumbnail   String?
  description String?
  videoCount  Int?

  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  downloads   Download[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([enabled])
  @@index([userId])
  @@map("subscriptions")
}

enum SubscriptionType {
  CHANNEL
  PLAYLIST
  USER
}

// Livestream monitoring
model Monitor {
  id          String    @id @default(cuid())
  url         String    @unique
  name        String
  type        MonitorType

  // Status
  enabled     Boolean   @default(true)
  isLive      Boolean   @default(false)
  lastChecked DateTime?
  waitTime    Int?      // seconds until live
  liveDate    DateTime?

  // Download settings
  profileId   String
  profile     DownloadProfile @relation(fields: [profileId], references: [id])
  autoDownload Boolean  @default(true)
  customFlags String[]  // Per-monitor yt-dlp flags (SponsorBlock, subtitles, etc.)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([enabled])
  @@index([isLive])
  @@map("monitors")
}

enum MonitorType {
  YOUTUBE_LIVE
  TWITCH
}

// Global application settings (singleton)
model Settings {
  id          String    @id @default("singleton")

  // Download settings
  maxConcurrentDownloads Int @default(3)
  downloadPath String   @default("/downloads")
  // Kill a download if it makes no progress for this many seconds (0 = disabled)
  downloadStallTimeoutSeconds Int @default(600)

  // Download speed tuning
  concurrentFragments Int     @default(4)   // yt-dlp --concurrent-fragments (0/1 = off)
  useAria2c           Boolean @default(false) // use aria2c external downloader when present
  httpChunkSize       String? // e.g. "10M" -> --http-chunk-size (null = omit)

  // Jellyfin artwork
  generateJellyfinPosters Boolean @default(true) // build 2:3 poster.jpg + 16:9 backdrop.jpg

  // yt-dlp settings
  ytdlpPath   String    @default("/usr/local/bin/yt-dlp")
  ytdlpVersion String?
  lastYtdlpUpdate DateTime?
  autoUpdateYtdlp Boolean @default(true)
  updateCheckInterval Int @default(86400) // seconds (daily)

  // Archive
  enableArchive Boolean @default(true)
  archivePath String?   // Path to archive.txt for yt-dlp

  // Cookie authentication for member/age-restricted content
  cookiePath  String?

  // Authentication
  authMode    String    @default("password") // "password" | "oidc" | "both"

  // OIDC (SSO). May instead be configured via env vars, which take precedence.
  oidcEnabled      Boolean @default(false)
  oidcIssuerUrl    String?
  oidcClientId     String?
  oidcClientSecret String? // encrypted at rest via crypto-box
  oidcDisplayName  String? // button label, e.g. "Company SSO" (defaults to "SSO")

  // Library & cache
  libraryPath     String?
  musicLibraryPath String?
  cacheQuotaBytes BigInt    @default(10737418240) // 10 GB — default per-user cache limit
  totalCacheQuotaBytes BigInt? // global total cache cap across all users; null = auto (disk capacity − 5 GB)

  // Jellyfin integration
  jellyfinUrl         String?
  jellyfinApiKey      String?
  jellyfinExternalUrl String?

  // Plex integration
  plexUrl             String?
  plexToken           String?

  // Auto-cleanup settings
  cleanupEnabled         Boolean  @default(false)
  cleanupUserIds         String[] @default([])
  cleanupIntervalSeconds Int      @default(3600)
  cleanupProfileTypes    String[] @default([])
  cleanupGraceHours      Int      @default(24)

  // Download limits
  maxDurationSeconds Int? @default(10800) // 3 hours default

  // Rate limiting
  rateLimit     String? // e.g. "5M" for 5MB/s, passed as --limit-rate
  sleepInterval Int?    // seconds between downloads, passed as --sleep-interval

  // Auto-delete watched videos
  autoDeleteWatchedDays Int?

  // Notifications (Apprise)
  appriseUrl       String?
  notifyOnComplete Boolean @default(false)
  notifyOnFail     Boolean @default(false)

  // Return YouTube Dislike integration
  rydEnabled       Boolean @default(false)

  // Backup
  backupEnabled    Boolean @default(false)
  backupCron       String?
  backupPath       String?

  // Reverse-proxy auth
  proxyAuthEnabled Boolean @default(false)
  proxyAuthHeader  String  @default("X-Forwarded-User")

  // LDAP
  ldapEnabled      Boolean @default(false)
  ldapUrl          String?
  ldapBindDn       String?
  ldapBindPassword String?
  ldapSearchBase   String?
  ldapSearchFilter String?

  // Version check
  versionCheckEnabled Boolean @default(true)

  // Multi-tenant / per-user access defaults
  // Library access mode for non-admin users without an explicit override:
  //   "free"     - anyone may save to the library directly
  //   "request"  - users submit a library-save request for admin approval
  //   "disabled" - library saving is off for non-admins
  libraryAccessMode        String  @default("free")
  statsVisibleToNonAdmins  Boolean @default(true)  // show the health/stats modal to non-admins
  showTotalSizeToNonAdmins Boolean @default(false) // expose global/disk totals to non-admins
  // NOTE: cacheQuotaBytes above doubles as the default per-user cache limit.

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("settings")
}

// A user's request to save a download to the library (used in "request" mode).
model LibraryRequest {
  id         String   @id @default(cuid())
  downloadId String   @unique
  download   Download @relation(fields: [downloadId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String   @default("pending") // pending | approved | denied
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
  resolvedBy String?  // admin user id who approved/denied

  @@index([status])
  @@index([userId])
  @@map("library_requests")
}

model UserPreference {
  id     String @id @default(cuid())
  userId String
  mode   String // "video_library", "video_cache", "audio_library", "audio_cache"
  prefs  Json   // { profileId, sponsorblock, subtitles, metadata, audioQuality }

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mode])
  @@index([userId])
  @@map("user_preferences")
}

// Archive entries (tracks completed downloads for deduplication)
model Archive {
  id          String    @id @default(cuid())
  videoId     String    @unique // e.g., YouTube video ID
  url         String
  title       String
  downloadedAt DateTime @default(now())

  @@index([videoId])
  @@map("archive")
}

// Watch progress tracking (per-user, per-download)
model WatchProgress {
  id         String    @id @default(cuid())
  userId     String
  downloadId String
  position   Float     @default(0)
  duration   Float?
  watched    Boolean   @default(false)
  watchedAt  DateTime?
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  download Download @relation(fields: [downloadId], references: [id], onDelete: Cascade)

  @@unique([userId, downloadId])
  @@index([userId])
  @@index([downloadId])
  @@map("watch_progress")
}

// Custom user playlists
model Playlist {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       PlaylistItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  // Null until the item is actually downloaded. Items synced from YouTube start
  // as "pending" — the video reference lives in the snapshot fields below, and
  // downloadId is filled in once a Download is created for it.
  downloadId String?
  position   Int
  playlist   Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  download   Download? @relation(fields: [downloadId], references: [id], onDelete: Cascade)
  addedAt    DateTime  @default(now())

  // Snapshot of the source video for pending (not-yet-downloaded) items.
  videoId   String?
  title     String?
  thumbnail String?
  sourceUrl String?

  @@unique([playlistId, downloadId])
  @@index([playlistId])
  @@index([playlistId, videoId])
  @@map("playlist_items")
}

// Per-channel download configuration overrides
model ChannelOverride {
  id             String   @id @default(cuid())
  channelUrl     String   @unique
  channelName    String?
  profileId      String?
  profile        DownloadProfile? @relation(fields: [profileId], references: [id])
  autoDeleteDays Int?
  sponsorblock   Boolean  @default(true)
  customFlags    String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("channel_overrides")
}

// Backup records
model Backup {
  id        String   @id @default(cuid())
  filename  String
  filepath  String
  sizeBytes BigInt
  type      String   @default("manual")
  createdAt DateTime @default(now())

  @@map("backups")
}

// Scheduled job run history
model ScheduledJobRun {
  id        String    @id @default(cuid())
  jobName   String
  status    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  error     String?
  details   String?

  @@index([jobName])
  @@index([startedAt])
  @@map("scheduled_job_runs")
}

model YouTubeLink {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  cookiesEnc      String   @db.Text        // AES-256-GCM, format iv:tag:ciphertext (base64)
  cookieUpdatedAt DateTime

  channelName     String?
  channelHandle   String?
  channelId       String?

  syncWatchedToYouTube Boolean @default(false)
  syncHistoryToWytui   Boolean @default(false)
  syncWatchLater       Boolean @default(false)
  useFeedForNewVideos  Boolean @default(false)

  lastFeedCheck   DateTime?
  lastHistorySync DateTime?
  lastError       String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("youtube_links")
}
